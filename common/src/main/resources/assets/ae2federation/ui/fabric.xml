<?xml version="1.0" encoding="UTF-8" ?>
<ldlib2-ui>
    <stylesheet location="ldlib2:lss/mc.lss"/>
    <stylesheet location="ae2federation:lss/fabric.lss"/>
    <root id="fabric_root" class="panel_bg fabric-panel">
        <element class="fabric-header">
            <label id="fabric_title" class="fabric-title"><lang key="ae2federation.ui.fabric.title"/></label>
            <label id="entrance_value" class="fabric-caption"><lang key="ae2federation.ui.fabric.status.pending"/></label>
        </element>
        <element class="fabric-workspace">
            <element class="fabric-sidebar fabric-left">
                <label class="fabric-heading"><lang key="ae2federation.ui.fabric.members.heading"/></label>
                <label id="members_value" class="fabric-summary"><lang key="ae2federation.ui.fabric.members.pending"/></label>
                <virtual-scroller-view id="member_list" class="fabric-list"/>
                <label class="fabric-heading"><lang key="ae2federation.ui.fabric.policy.heading"/></label>
                <label id="consumer_value" class="fabric-row"><lang key="ae2federation.ui.fabric.consumer"><style color="#ffffffff">-</style></lang></label>
                <button id="consumer_next" text="ae2federation.ui.fabric.action.next_consumer"/>
                <label id="provider_value" class="fabric-row"><lang key="ae2federation.ui.fabric.provider"><style color="#ffffffff">-</style></lang></label>
                <button id="provider_next" text="ae2federation.ui.fabric.action.next_provider"/>
                <label id="rule_value" class="fabric-row"><lang key="ae2federation.ui.fabric.rule.unavailable"/></label>
                <element class="policy-actions">
                    <button id="capability_next" text="ae2federation.ui.fabric.action.next_capability"/>
                    <button id="policy_toggle" text="ae2federation.ui.fabric.action.toggle"/>
                </element>
            </element>
            <element class="fabric-center">
                <element class="graph-toolbar">
                    <button id="graph_zoom_in" class="graph-zoom" text="ae2federation.ui.fabric.graph.zoom_in"/>
                    <button id="graph_zoom_out" class="graph-zoom" text="ae2federation.ui.fabric.graph.zoom_out"/>
                    <button id="graph_fit" class="graph-fit" text="ae2federation.ui.fabric.graph.fit"/>
                    <button id="physical_layer_toggle" class="graph-physical" text="ae2federation.ui.fabric.graph.physical"/>
                    <button id="capability_layer_toggle" class="graph-capability" text="ae2federation.ui.fabric.graph.capability"/>
                </element>
                <graph-view id="fabric_graph" class="fabric-graph"/>
                <label id="ack_status" class="fabric-status pending"><lang key="ae2federation.ui.fabric.status.pending"/></label>
            </element>
            <element class="fabric-sidebar fabric-right">
                <label class="fabric-heading"><lang key="ae2federation.ui.fabric.mapping.heading"/></label>
                <label id="mapping_provider_value" class="fabric-row">-</label>
                <button id="mapping_provider_next" text="ae2federation.ui.fabric.mapping.next_provider"/>
                <label id="mapping_selection_value" class="fabric-row">-</label>
                <element class="compact-actions">
                    <button id="mapping_slot_next" text="ae2federation.ui.fabric.mapping.next_slot"/>
                    <button id="mapping_lane_next" text="ae2federation.ui.fabric.mapping.next_lane"/>
                </element>
                <button id="mapping_toggle" text="ae2federation.ui.fabric.mapping.toggle"/>
                <label id="mapping_status" class="mapping-status"><lang key="ae2federation.ui.fabric.mapping.status"><style color="#ffffffff">ready</style></lang></label>
                <text-field id="pattern_search" mode="string" value="" class="pattern-search"/>
                <virtual-scroller-view id="pattern_list" class="pattern-list"/>
                <label class="fabric-heading"><lang key="ae2federation.ui.fabric.endpoint.heading"/></label>
                <button id="endpoint_next" text="ae2federation.ui.fabric.endpoint.next"/>
                <label id="endpoint_detail" class="endpoint-detail"><lang key="ae2federation.ui.fabric.endpoint.none"/></label>
            </element>
        </element>
    </root>
</ldlib2-ui>
