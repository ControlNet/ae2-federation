<?xml version="1.0" encoding="UTF-8" ?>
<ldlib2-ui>
    <stylesheet location="ldlib2:lss/mc.lss"/>
    <stylesheet location="ae2federation:lss/domain.lss"/>
    <root id="domain_root" class="panel_bg domain-panel">
        <element class="domain-header">
            <label id="domain_title" class="domain-title"><lang key="ae2federation.ui.domain.title"/></label>
            <label id="entrance_value" class="domain-caption"><lang key="ae2federation.ui.domain.status.pending"/></label>
        </element>
        <element class="domain-workspace">
            <element class="domain-sidebar domain-left">
                <label class="domain-heading"><lang key="ae2federation.ui.domain.members.heading"/></label>
                <label id="members_value" class="domain-summary"><lang key="ae2federation.ui.domain.members.pending"/></label>
                <virtual-scroller-view id="member_list" class="domain-list"/>
                <label class="domain-heading"><lang key="ae2federation.ui.domain.policy.heading"/></label>
                <label id="consumer_value" class="domain-row"><lang key="ae2federation.ui.domain.consumer"><style color="#ffffffff">-</style></lang></label>
                <button id="consumer_next" text="ae2federation.ui.domain.action.next_consumer"/>
                <label id="provider_value" class="domain-row"><lang key="ae2federation.ui.domain.provider"><style color="#ffffffff">-</style></lang></label>
                <button id="provider_next" text="ae2federation.ui.domain.action.next_provider"/>
                <label id="rule_value" class="domain-row"><lang key="ae2federation.ui.domain.rule.unavailable"/></label>
                <element class="policy-actions">
                    <button id="capability_next" text="ae2federation.ui.domain.action.next_capability"/>
                    <button id="policy_toggle" text="ae2federation.ui.domain.action.toggle"/>
                </element>
            </element>
            <element class="domain-center">
                <element class="graph-toolbar">
                    <button id="graph_zoom_in" class="graph-zoom" text="ae2federation.ui.domain.graph.zoom_in"/>
                    <button id="graph_zoom_out" class="graph-zoom" text="ae2federation.ui.domain.graph.zoom_out"/>
                    <button id="graph_fit" class="graph-fit" text="ae2federation.ui.domain.graph.fit"/>
                    <button id="physical_layer_toggle" class="graph-physical" text="ae2federation.ui.domain.graph.physical"/>
                    <button id="capability_layer_toggle" class="graph-capability" text="ae2federation.ui.domain.graph.capability"/>
                </element>
                <graph-view id="domain_graph" class="domain-graph"/>
                <label id="ack_status" class="domain-status pending"><lang key="ae2federation.ui.domain.status.pending"/></label>
            </element>
            <element class="domain-sidebar domain-right">
                <label class="domain-heading"><lang key="ae2federation.ui.domain.mapping.heading"/></label>
                <label id="mapping_provider_value" class="domain-row">-</label>
                <button id="mapping_provider_next" text="ae2federation.ui.domain.mapping.next_provider"/>
                <label id="mapping_selection_value" class="domain-row">-</label>
                <element class="compact-actions">
                    <button id="mapping_slot_next" text="ae2federation.ui.domain.mapping.next_slot"/>
                    <button id="mapping_lane_next" text="ae2federation.ui.domain.mapping.next_lane"/>
                </element>
                <element class="compact-actions">
                    <button id="mapping_toggle" text="ae2federation.ui.domain.mapping.toggle"/>
                    <button id="mapping_release" text="ae2federation.ui.domain.mapping.release"/>
                </element>
                <label id="mapping_status" class="mapping-status"><lang key="ae2federation.ui.domain.mapping.status"><style color="#ffffffff">ready</style></lang></label>
                <text-field id="pattern_search" mode="string" value="" class="pattern-search"/>
                <virtual-scroller-view id="pattern_list" class="pattern-list"/>
                <label class="domain-heading"><lang key="ae2federation.ui.domain.endpoint.heading"/></label>
                <button id="endpoint_next" text="ae2federation.ui.domain.endpoint.next"/>
                <label id="endpoint_detail" class="endpoint-detail"><lang key="ae2federation.ui.domain.endpoint.none"/></label>
            </element>
        </element>
    </root>
</ldlib2-ui>
