<?xml version="1.0" encoding="UTF-8" ?>
<ldlib2-ui>
    <stylesheet location="ldlib2:lss/modern.lss"/>
    <stylesheet location="ae2federation:lss/domain.lss"/>
    <root id="domain_root" class="domain-shell">
        <element id="workspace_tabs" class="workspace-rail">
            <button id="tab_overview" class="rail-tab" text=""/>
            <button id="tab_mapping" class="rail-tab" text=""/>
            <button id="tab_diagnostics" class="rail-tab" text=""/>
        </element>
        <element id="domain_window" class="domain-panel">
            <element class="domain-header">
                <element class="header-titles">
                    <label id="domain_title" class="domain-title"><lang key="ae2federation.ui.domain.title"/></label>
                    <element class="header-status">
                        <element id="sync_lamp" class="sync-lamp"/>
                        <label id="entrance_value" class="domain-caption"/>
                        <label id="members_value" class="domain-caption members-caption"/>
                    </element>
                </element>
                <text-field id="graph_search" mode="string" value=""/>
                <button id="return_provider" class="return-provider" text="ae2federation.ui.workspace.back_provider"/>
            </element>
            <element id="bridge_unavailable" class="bridge-unavailable">
                <label id="bridge_diagnostic_title" class="domain-heading"><lang key="ae2federation.ui.workspace.bridge_unavailable"/></label>
                <label id="bridge_diagnostic_help" class="page-description"><lang key="ae2federation.ui.workspace.bridge_reopen"/></label>
            </element>
            <element id="page_overview" class="workspace-page topology-page">
                <element class="topology-canvas">
                    <graph-view id="domain_graph" class="domain-graph"/>
                    <element class="graph-toolbar">
                        <button id="graph_zoom_in" class="toolbar-button" text="+"/>
                        <button id="graph_zoom_out" class="toolbar-button" text="-"/>
                        <button id="graph_fit" class="toolbar-button" text="□"/>
                    </element>
                    <label id="graph_search_empty" class="graph-search-empty"/>
                    <label id="graph_legend" class="graph-legend"><lang key="ae2federation.ui.topology.legend"/></label>
                </element>
                <scroller-view id="topology_aside" class="topology-aside">
                    <element id="network_detail" class="aside-section">
                        <element class="aside-title-row">
                            <element id="network_accent" class="network-accent"/>
                            <label id="network_title" class="aside-title"/>
                            <button id="network_rename" class="title-action" text="ae2federation.ui.topology.rename"/>
                        </element>
                        <element id="network_rename_row" class="rename-row">
                            <text-field id="network_rename_field" mode="string" value=""/>
                            <element class="compact-actions">
                                <button id="network_rename_save" class="primary-action" text="ae2federation.ui.topology.rename_save"/>
                                <button id="network_rename_cancel" text="ae2federation.ui.topology.rename_cancel"/>
                            </element>
                        </element>
                        <label id="network_identity" class="aside-caption"/>
                        <element class="dark-panel">
                            <label id="graph_selection" class="panel-text"><lang key="ae2federation.ui.workspace.select_node"/></label>
                        </element>
                        <button id="graph_open" class="primary-action" text="ae2federation.ui.topology.devices"/>
                        <label id="network_links_heading" class="aside-heading"/>
                        <element id="network_links" class="network-links"/>
                        <element id="network_location" class="dark-panel location-panel">
                            <element id="network_preview" class="map-preview"/>
                            <label id="network_location_note" class="panel-text"/>
                            <button id="network_highlight" text="ae2federation.ui.location.highlight"/>
                        </element>
                        <element id="network_stats" class="dark-panel network-stats"/>
                    </element>
                    <element id="pair_editor" class="aside-section">
                        <label id="pair_title" class="aside-title"/>
                        <label id="pair_note" class="paper-note"><lang key="ae2federation.ui.topology.pair_note"/></label>
                        <element id="pair_sections" class="pair-sections"/>
                    </element>
                </scroller-view>
            </element>
            <element id="page_mapping" class="workspace-page">
                <element class="mapping-toolbar">
                    <label class="domain-heading"><lang key="ae2federation.ui.workspace.provider"/></label>
                    <selector id="mapping_provider_next"/>
                    <label id="mapping_provider_value" class="identity-caption"/>
                    <element id="mapping_view_switch" class="view-switch">
                        <button id="mapping_view_graph" text="ae2federation.ui.processing.view_wires"/>
                        <button id="mapping_view_list" text="ae2federation.ui.processing.view_list"/>
                    </element>
                </element>
                <element id="processing_graph" class="processing-graph">
                    <scroller-view id="processing_scroll" class="processing-scroll"/>
                    <element class="dark-panel processing-detail">
                        <label id="processing_detail_text" class="panel-text"/>
                        <element id="processing_preview" class="map-preview"/>
                        <button id="processing_highlight" text="ae2federation.ui.location.highlight"/>
                        <element class="compact-actions">
                            <button id="processing_unlink" class="danger-action" text="ae2federation.ui.processing.unlink"/>
                            <button id="processing_release" class="danger-action" text="ae2federation.ui.domain.mapping.release"/>
                        </element>
                        <label id="processing_status" class="mapping-status"/>
                    </element>
                </element>
                <element id="mapping_list" class="mapping-body">
                    <element class="pattern-column">
                        <element class="pattern-search-row">
                            <text-field id="pattern_search" mode="string" value=""/>
                            <button id="pattern_show_empty" text="ae2federation.ui.workspace.show_empty"/>
                        </element>
                        <label id="pattern_summary" class="domain-caption"/>
                        <label id="pattern_empty" class="empty-message"/>
                        <virtual-scroller-view id="pattern_list" class="pattern-list"/>
                    </element>
                    <element class="target-column">
                        <label class="domain-heading"><lang key="ae2federation.ui.workspace.pattern"/></label>
                        <selector id="mapping_slot_next"/>
                        <label class="domain-heading"><lang key="ae2federation.ui.workspace.target"/></label>
                        <selector id="mapping_lane_next"/>
                        <label id="mapping_selection_value" class="mapping-selection"/>
                        <element class="compact-actions">
                            <button id="mapping_toggle" class="primary-action" text="ae2federation.ui.domain.mapping.toggle"/>
                            <button id="mapping_release" class="danger-action" text="ae2federation.ui.domain.mapping.release"/>
                        </element>
                        <scroller-view id="mapping_feedback_scroll" class="diagnostic-scroll feedback-scroll">
                            <label id="mapping_status" class="mapping-status"/>
                        </scroller-view>
                    </element>
                </element>
            </element>
            <element id="page_diagnostics" class="workspace-page">
                <label id="diagnostics_description" class="page-description"><lang key="ae2federation.ui.workspace.diagnostics_help"/></label>
                <element class="diagnostic-toolbar">
                    <selector id="endpoint_next"/>
                    <label id="endpoint_local"/>
                    <button id="endpoint_browse" text="ae2federation.ui.workspace.endpoints_browse"/>
                    <button id="endpoint_locate" text="ae2federation.ui.workspace.endpoint_locate"/>
                </element>
                <element class="endpoint-columns">
                    <element class="endpoint-column">
                        <label class="domain-heading"><lang key="ae2federation.ui.workspace.operation"/></label>
                        <scroller-view id="endpoint_operation_scroll" class="diagnostic-scroll">
                            <label id="endpoint_detail" class="endpoint-facts"/>
                        </scroller-view>
                    </element>
                    <element class="endpoint-column">
                        <label class="domain-heading"><lang key="ae2federation.ui.workspace.identity_ownership"/></label>
                        <scroller-view id="endpoint_identity_scroll" class="diagnostic-scroll">
                            <label id="endpoint_identity" class="endpoint-facts"/>
                        </scroller-view>
                    </element>
                </element>
                <element class="compact-actions diagnostic-navigation">
                    <button id="endpoint_mapping" text="ae2federation.ui.workspace.endpoint_mapping"/>
                    <button id="endpoint_policy" text="ae2federation.ui.workspace.endpoint_policy"/>
                </element>
            </element>
            <element class="domain-footer">
                <label id="ack_status" class="domain-status pending"/>
                <label id="request_status" class="domain-status request-status"/>
            </element>
        </element>
    </root>
</ldlib2-ui>
