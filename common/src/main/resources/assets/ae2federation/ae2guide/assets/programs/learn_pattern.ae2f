def learn_pattern(item: Item) -> bool:
    # Write a pattern for the item into a provider that faces a machine running one of its
    # recipes, such as a Molecular Assembler or a furnace, unless a pattern makes it already.
    if ae2.craftable(item):
        return False
    for recipe in mc.recipes_for(item):
        for provider in ae2.providers():
            for machine in recipe.machines:
                if machine in provider.targets and provider.free > 0:
                    return ae2.write_pattern(provider, recipe)
    return False
