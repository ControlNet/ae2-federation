// ME Federation Pattern Provider screen: the workspace frame, one Provider's wires, its slots and the player inventory.

.provider-settings { height: 20; flex-shrink: 0; flex-direction: row; gap-all: 1; }
.domain-panel .provider-settings .header-icon { width: 18; height: 20; padding-all: 0; }
.domain-panel .priority-label { height: 10; adaptive-width: true; flex-shrink: 0; text-color: #ff3f3d52; }
#provider_priority { width: 36; flex-shrink: 0; }

.provider-body { flex: 1; min-height: 0; width: 100%; flex-direction: row; gap-all: 5; }
.provider-main { flex: 1; min-width: 0; height: 100%; gap-all: 5; }
.provider-canvas { width: 100%; flex: 1; min-height: 0; }

.provider-noface { position: absolute; left: 24%; top: 22%; width: 52%; padding-all: 7; gap-all: 4; display: none; background: built-in(federation:DARK_PANEL); }
.domain-panel .provider-noface .provider-noface-title { width: 100%; height: 10; text-color: #ffffd65a; }
.domain-panel .provider-noface .provider-noface-text { width: 100%; adaptive-height: true; text-wrap: wrap; text-color: #ffd6d0e0; }
.domain-panel .provider-noface .provider-noface-kept { width: 100%; adaptive-height: true; text-wrap: wrap; text-color: #ffaaa4b2; }

.provider-lower { width: 100%; height: 92; flex-shrink: 0; flex-direction: row; gap-all: 12; }
.provider-inventory { width: 162; flex-shrink: 0; gap-all: 3; }
.provider-returns { flex: 1; min-width: 0; height: 100%; gap-all: 3; }
.provider-return-list { width: 100%; flex: 1; min-height: 0; padding-all: 3; scroller-view-mode: vertical; }
.provider-return-list .__scroller_view_view-port__ { padding-all: 0; background: #00000000; }
.provider-return-list .__scroller_view_view-container__ { width: 100%; gap-all: 1; }
.provider-return-row { width: 100%; height: 12; flex-shrink: 0; flex-direction: row; gap-all: 4; align-items: center; padding-horizontal: 2; }
.provider-return-swatch { width: 5; height: 5; flex-shrink: 0; }
.domain-panel .provider-return-row .provider-return-where { width: 124; height: 9; flex-shrink: 0; text-wrap: hide; text-color: #ffd6d0e0; }
.domain-panel .provider-return-row .provider-return-state { flex: 1; min-width: 0; height: 9; text-wrap: hide; }
.domain-panel .provider-returns-note { flex-shrink: 0; }

.pattern-slot-store { position: absolute; width: 0; height: 0; display: none; }
.processing-pattern item-slot { width: 16; height: 16; flex-shrink: 0; }
// Real slots look like vanilla's sunken slot, as in the design, on both the light frame and the dark canvas.
.provider-shell item-slot { background: built-in(ui-mc:RECT_1); }

.domain-shell.compact .provider-lower { height: 80; }
.domain-shell.compact .provider-returns-note { display: none; }
