// Federation workspace in the NeoECO AE Extension palette. Sizes are GUI units; text uses Minecraft's font at native size.

.domain-shell { flex-direction: row; padding-all: 0; gap-all: 0; }
.domain-shell label, .domain-shell text-field, .domain-shell .__button_text__ { font: minecraft:default; text-shadow: false; }

// The rail's column fills the window's height; the rail itself, and its background, end under its last tab.
.workspace-rail-column { width: 22; flex-shrink: 0; flex-direction: column; }
.workspace-rail { width: 22; flex-shrink: 0; margin-top: 38; padding-top: 4; padding-bottom: 6; padding-left: 3; gap-all: 3; background: built-in(federation:RAIL); }
// AE2's toolbar sprite at its own 18x20 size; FederationWorkspace puts each tab's icon on it.
.workspace-rail .rail-tab { width: 18; height: 20; padding-all: 0; }

.domain-panel { flex: 1; min-width: 0; height: 100%; padding-all: 6; padding-bottom: 8; gap-all: 5; flex-direction: column; background: built-in(federation:FRAME); }
.domain-panel label { adaptive-width: false; text-color: #ff413f54; font-size: 9; }
.domain-panel button { height: 18; padding-all: 2; padding-bottom: 5; base-background: built-in(federation:BUTTON); hover-background: built-in(federation:HOVER); pressed-background: built-in(federation:PRESSED); }
.domain-panel button .__button_text__ { font-size: 9; adaptive-width: false; width: 100%; margin-horizontal: 0; text-color: #ff413f54; }
.domain-panel button.__disabled__ { base-background: built-in(federation:DISABLED); }
.domain-panel button.__disabled__ .__button_text__ { text-color: #ff2c2735; }
.domain-panel button.selected { base-background: built-in(federation:HOVER); }
.domain-panel .primary-action { base-background: built-in(federation:HOVER); }
.domain-panel .primary-action .__button_text__ { text-color: #ff1f2438; }
.domain-panel .danger-action { base-background: built-in(federation:DANGER); }
// AE2's text field: light text on its grey-blue inset, without LDLib2's focus rectangle.
.domain-panel text-field { height: 16; padding-all: 3; padding-top: 4; background: built-in(federation:FIELD); focus-overlay: empty; text-color: #fff2f2f2; font-size: 9; }

.domain-header { width: 100%; height: 26; flex-shrink: 0; flex-direction: row; gap-all: 6; align-items: center; }
.header-titles { flex: 1; min-width: 0; gap-all: 3; }
.title-row { height: 10; flex-direction: row; }
.domain-panel .domain-title { height: 10; adaptive-width: true; flex-shrink: 0; text-color: #ff413f54; }
.domain-panel .domain-tab { height: 10; flex: 1; min-width: 0; text-color: #ff6d6a82; }
.header-status { height: 10; flex-direction: row; gap-all: 4; align-items: center; }
.sync-lamp { width: 5; height: 5; flex-shrink: 0; background: #ff55ff8a; }
.domain-caption { height: 10; flex-shrink: 1; min-width: 0; text-color: #ff6d6a82; }
.domain-panel .members-caption { flex-shrink: 0; adaptive-width: true; }
.domain-panel .header-status .off-page { display: none; }
.header-tools { height: 20; flex-shrink: 0; flex-direction: row; gap-all: 5; }
.scope-segment { height: 20; flex-direction: row; gap-all: 1; }
.domain-panel .header-tools .header-icon { width: 20; height: 20; padding-all: 0; }
#graph_search { width: 150; flex-shrink: 0; }
.return-provider { width: 104; flex-shrink: 0; display: none; }

.workspace-page { flex: 1; min-height: 0; width: 100%; gap-all: 5; }
.topology-page { flex-direction: row; }
.topology-canvas { flex: 1; min-width: 0; height: 100%; }
.domain-graph { width: 100%; height: 100%; allow-pan: true; allow-zoom: true; min-scale: 0.1; max-scale: 3; grid-size: 16; grid-subdivisions: 4; grid-line-color: #0dd8d3e4; grid-accent-color: #1ad8d3e4; background: #ff201e27; }
.graph-toolbar { position: absolute; right: 3; top: 3; flex-direction: row; gap-all: 2; }
.domain-panel .graph-toolbar .toolbar-button { width: 16; height: 16; padding-all: 0; padding-bottom: 2; }
.domain-panel .graph-throughput { position: absolute; left: 4; top: 5; width: 150; height: 10; text-color: #ffaaa4b2; }
.graph-search-empty { position: absolute; left: 4; top: 16; width: 150; height: 10; display: none; text-color: #ffffd65a; }
.domain-panel .graph-legend { position: absolute; left: 6; bottom: 6; max-width: 96%; adaptive-width: true; adaptive-height: true; text-wrap: wrap; padding-all: 3; padding-horizontal: 5; text-color: #ffaaa4b2; background: #eb17141e; }
// The Federation power gauge in the other corner: the converters' buffer fill, coloured by FederationTopologyView.
.domain-panel .graph-power { position: absolute; right: 4; bottom: 3; width: 112; height: 16; background: #eb17141e; }
.domain-panel .graph-power-name { position: absolute; left: 5; top: 3; width: 31; height: 10; text-color: #ffaaa4b2; text-wrap: hide; }
.graph-power-track { position: absolute; left: 38; top: 7; width: 40; height: 2; background: #ff2c2935; }
.graph-power-fill { position: absolute; left: 0; top: 0; width: 0; height: 2; background: #ff55ff8a; }
.domain-panel .graph-power-value { position: absolute; right: 4; top: 3; width: 26; height: 10; horizontal-align: right; text-wrap: hide; }

.topology-aside { width: 30%; min-width: 176; max-width: 320; flex-shrink: 0; height: 100%; scroller-view-mode: vertical; }
.topology-aside .__scroller_view_view-port__ { padding-all: 0; background: #00000000; }
.aside-section { width: 100%; flex-shrink: 0; gap-all: 4; }
.aside-title-row { height: 12; flex-direction: row; gap-all: 4; align-items: center; }
.network-accent { width: 7; height: 7; flex-shrink: 0; background: #ff61afef; }
.aside-title { flex: 1; min-width: 0; height: 10; }
.domain-panel #pair_title { width: 100%; adaptive-height: true; flex-shrink: 0; text-wrap: wrap; }
.domain-panel .aside-caption { width: 100%; adaptive-height: true; flex-shrink: 0; text-wrap: wrap; text-color: #ff6d6a82; }
.domain-panel .aside-heading { height: 10; flex-shrink: 0; text-color: #ff413f54; }
.dark-panel { width: 100%; flex-shrink: 0; padding-all: 5; gap-all: 3; background: built-in(federation:DARK_PANEL); }
.domain-panel .dark-panel label { text-color: #ffd6d0e0; }
.domain-panel .panel-text { width: 100%; adaptive-height: true; flex-shrink: 0; text-wrap: wrap; }
.network-links { width: 100%; flex-shrink: 0; gap-all: 2; }
.domain-panel .links-note { width: 100%; adaptive-height: true; text-wrap: wrap; text-color: #ff6d6a82; }
.domain-panel .title-action { width: 50; height: 12; padding-all: 0; padding-bottom: 2; flex-shrink: 0; }
.rename-row { width: 100%; flex-shrink: 0; gap-all: 3; display: none; }
.rename-row #network_rename_field { width: 100%; }
.network-stats { gap-all: 3; padding-horizontal: 6; }
.location-panel { gap-all: 4; }
.location-head { width: 100%; height: 12; flex-shrink: 0; flex-direction: row; gap-all: 4; align-items: center; justify-content: flex-end; }
.map-mode-switch { height: 12; flex-shrink: 0; flex-direction: row; padding-all: 1; gap-all: 1; background: #ff17141e; }
.domain-panel .map-mode-switch .map-mode { width: 24; height: 10; padding-all: 0; padding-bottom: 1; base-background: #00000000; hover-background: #ff47434f; pressed-background: #ff605a66; }
.domain-panel .map-mode-switch .map-mode .__button_text__ { text-color: #ffaaa4b2; }
.domain-panel .map-mode-switch .map-mode.selected { base-background: #ff605a66; }
.domain-panel .map-mode-switch .map-mode.selected .__button_text__ { text-color: #ffefeaf8; }
// The map keeps the design's 16:10 panel; a compact aside gives it a letterbox instead.
.map-preview { width: 100%; aspect-rate: 1.6; flex-shrink: 0; background: #ff17141e; }
.compact .map-preview { aspect-rate: 2.6; }
.domain-panel .location-legend { width: 100%; adaptive-height: true; flex-shrink: 0; text-wrap: wrap; text-color: #ffaaa4b2; }
.domain-panel .panel-caption { width: 100%; height: 9; flex-shrink: 0; text-color: #ffaaa4b2; }
.network-actions { width: 100%; }
.domain-panel .stat-line { width: 100%; adaptive-height: true; flex-shrink: 0; text-wrap: wrap; }
.stat-row { width: 100%; height: 10; flex-shrink: 0; flex-direction: row; gap-all: 5; align-items: center; }
.domain-panel .stat-row .stat-name { width: 52; height: 9; flex-shrink: 0; text-color: #ffaaa4b2; }
.stat-bar { flex: 1; min-width: 10; height: 5; }
.domain-panel .stat-row .stat-value { min-width: 88; adaptive-width: true; height: 9; flex-shrink: 0; horizontal-align: right; text-wrap: hide; }
.domain-panel .network-link { height: 18; padding-right: 12; }
.domain-panel .network-link .__button_text__ { horizontal-align: left; }
.domain-panel .paper-note { width: 100%; adaptive-height: true; flex-shrink: 0; padding-all: 3; text-wrap: wrap; text-color: #ff413f54; background: #fff2f2f2; }
.domain-panel .paper-note.read-only-banner { text-color: #ff5b3d12; background: #ffffe6a8; }
.pair-sections { width: 100%; flex-shrink: 0; gap-all: 4; }
.domain-panel .pair-section-title { width: 100%; adaptive-height: true; flex-shrink: 0; text-wrap: wrap; text-color: #ffefeaf8; }
.policy-row { width: 100%; flex-shrink: 0; gap-all: 2; padding-top: 4; padding-bottom: 2; background: built-in(federation:ROW_RULE); }
.policy-row-head { width: 100%; flex-direction: row; gap-all: 4; align-items: flex-start; }
.domain-panel .policy-capability { width: 62; flex-shrink: 0; height: 10; margin-top: 2; text-color: #ffd6d0e0; }
.domain-panel .policy-state { flex: 1; min-width: 0; adaptive-height: true; margin-top: 2; text-wrap: wrap; }
.domain-panel .policy-link { width: 36; height: 12; padding-all: 0; padding-bottom: 1; flex-shrink: 0; base-background: built-in(federation:LINK); hover-background: built-in(federation:LINK_HOVER); pressed-background: built-in(federation:LINK_HOVER); }
.domain-panel .policy-link .__button_text__ { text-color: #ffd6d0e0; }
.domain-panel button.policy-link.__disabled__ { base-background: built-in(federation:LINK); }
.domain-panel button.policy-link.__disabled__ .__button_text__ { text-color: #ff6d6a82; }
.domain-panel .policy-switch { width: 22; height: 12; padding-all: 0; flex-shrink: 0; }
.domain-panel button.policy-switch.__disabled__ { base-background: built-in(federation:SWITCH_OFF_LOCKED); }
.domain-panel button.policy-switch.on.__disabled__ { base-background: built-in(federation:SWITCH_ON_LOCKED); }
.domain-panel button.policy-switch.on.reexport.__disabled__ { base-background: built-in(federation:SWITCH_REEXPORT_LOCKED); }

// The Automation tab: the programs on the left, the opened ones as tabs above the script on the right.
.auto-view { width: 100%; height: 100%; flex-direction: row; gap-all: 6; }
.domain-panel .header-tools .auto-mode { width: 40; }
.auto-install-canvas { flex: 1; min-width: 0; height: 100%; scroller-view-mode: vertical; }
.auto-install-canvas .__scroller_view_view-port__ { padding-all: 0; background: #00000000; }
.auto-install-canvas .__scroller_view_view-container__ { width: 100%; }
.install-canvas { padding-all: 8; padding-right: 10; }
.install-column { width: 40%; flex-shrink: 0; gap-all: 6; }
.domain-panel .install-heading { width: 100%; height: 10; text-color: #ffefeaf8; }
.install-card { width: 100%; flex-shrink: 0; padding-all: 2; gap-all: 1; }
.install-card-head { width: 100%; height: 12; flex-direction: row; align-items: center; gap-all: 3; padding-left: 3; }
.install-device-head { width: 100%; height: 22; flex-direction: row; align-items: center; gap-all: 3; }
.install-device-port { width: 4; height: 12; flex-shrink: 0; }
.install-device-lines { flex: 1; min-width: 0; gap-all: 2; }
.install-row { width: 100%; height: 13; flex-shrink: 0; flex-direction: row; align-items: center; gap-all: 3; padding-left: 5; }
.install-row.installation.selected { background: built-in(federation:KIND_CHIP_SELECTED); }
.install-square { width: 4; height: 4; flex-shrink: 0; }
.install-icon { width: 8; height: 8; flex-shrink: 0; }
.install-port { width: 6; height: 13; flex-shrink: 0; }
.domain-panel .install-name { flex: 1; min-width: 0; height: 9; text-wrap: hide; text-color: #ffefeaf8; }
.domain-panel .install-title { width: 100%; height: 9; text-wrap: hide; text-color: #ffefeaf8; }
.domain-panel .install-device-lines .install-muted { width: 100%; }
.domain-panel .install-function { adaptive-width: true; height: 9; flex-shrink: 0; text-color: #ffefeaf8; }
.domain-panel .install-muted { height: 9; text-wrap: hide; text-color: #ffaaa4b2; }
.domain-panel .install-summary { flex: 1; min-width: 0; }
.domain-panel .install-count { adaptive-width: true; height: 9; flex-shrink: 0; text-color: #ff8377ff; }
.domain-panel .install-note { width: 100%; height: 9; text-color: #ff6f6a7a; }
.auto-install-aside { width: 34%; min-width: 150; max-width: 300; height: 100%; flex-shrink: 0; scroller-view-mode: vertical; }
.auto-install-aside .__scroller_view_view-port__ { padding-all: 0; background: #00000000; }
.auto-install-aside .__scroller_view_view-container__ { width: 100%; gap-all: 5; padding-top: 2; }
.domain-panel .install-aside-title { width: 100%; height: 10; text-wrap: hide; text-color: #ff413f54; }
.domain-panel .install-aside-caption { width: 100%; adaptive-height: true; text-wrap: wrap; text-color: #ff6d6a82; }
.install-fact { width: 100%; flex-shrink: 0; flex-direction: row; align-items: center; gap-all: 4; }
.domain-panel .install-fact-name { width: 56; flex-shrink: 0; height: 9; text-color: #ff413f54; }
.install-value { width: 100%; height: 13; flex-shrink: 0; flex-direction: row; align-items: center; gap-all: 3; padding-left: 3; background: built-in(federation:FIELD); }
.domain-panel .install-value-text { flex: 1; min-width: 0; height: 9; text-wrap: hide; text-color: #ff413f54; }
.domain-panel .install-fact.running .install-value-text { text-color: #ff28633b; }
.install-edit { flex-grow: 1; min-width: 0; height: 13; }
.install-edit.narrow { flex-grow: 0; width: 64; }
.domain-panel .install-edit text-field { width: 100%; height: 13; padding-all: 0; padding-left: 3; padding-top: 2; text-color: #ff413f54; }
.install-fact.sub { padding-left: 8; }
.domain-panel .install-fact.sub .install-fact-name { width: 48; text-color: #ff6d6a82; }
.install-dropdown { flex-grow: 1; min-width: 0; }
.domain-panel .install-arrow { width: 7; height: 9; flex-shrink: 0; text-color: #ff413f54; }
.domain-panel .install-dropdown text-field { width: 100%; height: 13; padding-all: 0; padding-left: 3; padding-top: 2; text-color: #ff413f54; }
.install-choices { width: 100%; padding-all: 2; gap-all: 1; background: #f017141e; }
.install-choice { width: 100%; height: 11; flex-direction: row; align-items: center; padding-left: 2; }
.domain-panel .install-choice-text { flex: 1; min-width: 0; height: 9; text-wrap: hide; text-color: #ff8fc8ff; }
.domain-panel .install-choice-note { width: 100%; adaptive-height: true; text-wrap: wrap; padding-top: 2; text-color: #ffaaa4b2; }
.install-chips { flex: 1; min-width: 0; flex-direction: row; gap-all: 3; }
.domain-panel button.install-chip { height: 14; flex-shrink: 0; padding-bottom: 4; }
.domain-panel .install-log-heading { width: 100%; height: 9; margin-top: 4; text-color: #ff413f54; }
.install-log { width: 100%; flex-shrink: 0; padding-all: 4; gap-all: 2; background: #ff1f1d26; }
.install-log-row { width: 100%; flex-shrink: 0; flex-direction: row; gap-all: 6; }
.domain-panel .install-log-age { width: 30; height: 9; flex-shrink: 0; text-color: #ff6d6a82; }
.domain-panel .install-log-text { flex: 1; min-width: 0; adaptive-height: true; text-wrap: wrap; text-color: #ffefeaf8; }
.domain-panel .install-log-text.failed { text-color: #ffff6a75; }
.domain-panel .install-log-text.note { text-color: #ffaaa4b2; }
.install-actions { width: 100%; flex-shrink: 0; flex-direction: row; gap-all: 3; margin-top: 6; }
.install-actions button { flex: 1; }
.auto-side { width: 26%; min-width: 120; max-width: 220; height: 100%; flex-shrink: 0; gap-all: 4; }
.auto-box { padding-all: 3; gap-all: 3; background: built-in(federation:CANVAS_BOX); }
.auto-programs { width: 100%; flex: 1; min-height: 0; }
.auto-box-head { width: 100%; height: 12; flex-shrink: 0; flex-direction: row; align-items: center; }
.domain-panel .auto-box-title { flex: 1; min-width: 0; height: 10; margin-left: 2; margin-top: 1; text-color: #ffefeaf8; }
.domain-panel .kind-chip.auto-new { width: 32; }
.auto-new-row { width: 100%; flex-shrink: 0; }
.domain-panel .auto-new-row text-field { width: 100%; height: 13; padding-top: 3; background: #ff17141e; text-color: #ffefeaf8; }
.domain-panel .header-tools .auto-push { width: 34; height: 16; padding-bottom: 4; }
.domain-panel .automation-answer { flex: 1; min-width: 0; margin-left: 6; text-wrap: hide; }
.domain-panel .automation-answer.refused { text-color: #ffa3201a; }
.auto-list { width: 100%; flex: 1; min-height: 0; scroller-view-mode: vertical; }
.auto-list .__scroller_view_view-port__ { padding-all: 0; background: #00000000; }
.auto-list .__scroller_view_view-container__ { width: 100%; }
.program-row { width: 100%; height: 13; flex-shrink: 0; flex-direction: row; align-items: center; padding-left: 5; padding-right: 4; }
.program-row.selected { background: built-in(federation:KIND_CHIP_SELECTED); }
.program-row.function-row { padding-left: 15; }
.domain-panel .program-name { flex: 1; min-width: 0; height: 9; text-wrap: hide; text-color: #ffd6d0e0; }
.domain-panel .program-row.selected .program-name { text-color: #ffefeaf8; }
.domain-panel .program-row.private .program-name { text-color: #ff6f6a7a; }
.program-installed { width: 4; height: 4; flex-shrink: 0; }
.domain-panel .program-problems { adaptive-width: true; height: 9; flex-shrink: 0; text-color: #ffff6a75; }
.auto-library { width: 100%; flex: 2; min-height: 0; }
.domain-panel .auto-library-search { width: 100%; height: 13; flex-shrink: 0; padding-top: 3; background: #ff17141e; text-color: #ffefeaf8; }
.library-row { width: 100%; height: 13; flex-shrink: 0; flex-direction: row; align-items: center; padding-left: 5; padding-right: 4; gap-all: 3; }
.library-row.library-function { padding-left: 17; }
.domain-panel .library-arrow { width: 6; height: 9; flex-shrink: 0; text-color: #ffaaa4b2; }
.domain-panel .library-row .program-name { text-color: #ffefeaf8; }
.domain-panel .library-row.library-function .program-name { text-color: #ff7fb6ff; }
.domain-panel .library-count { adaptive-width: true; height: 9; flex-shrink: 0; text-color: #ff6f6a7a; }
.library-acts { width: 3; height: 3; flex-shrink: 0; background: #ffb26cff; }
.auto-library-doc .__scroller_view_view-container__ { padding-left: 2; padding-right: 2; gap-all: 3; }
.domain-panel .library-text { width: 100%; adaptive-height: true; flex-shrink: 0; text-wrap: wrap; text-color: #ffd6d0e0; }
.domain-panel .library-text.signature { text-color: #ffaaa4b2; }
.domain-panel .library-text.heading { margin-top: 3; text-color: #ffefeaf8; }
.library-acts-row { width: 100%; height: 9; flex-shrink: 0; flex-direction: row; align-items: center; gap-all: 3; }
.domain-panel .library-acts-row .library-text { flex: 1; width: auto; min-width: 0; text-wrap: hide; adaptive-height: false; height: 9; }
.library-example { width: 100%; flex-shrink: 0; padding-all: 1; background: #ff3a3545; }
.domain-panel .library-example .script-editor { font-size: 7; line-spacing: 2; scroller-view-mode: horizontal; scroller-horizontal-display: never; background: #ff17141e; }
.domain-panel .library-example .script-editor .__text-area_content-view__ { padding-top: 3; }
.domain-panel .program-empty { width: 100%; height: 9; margin-left: 5; margin-top: 2; text-color: #ff6f6a7a; }
.auto-editor-box { flex: 1; min-width: 0; height: 100%; }
.auto-file-tabs { width: 100%; height: 12; flex-shrink: 0; flex-direction: row; gap-all: 2; }
.auto-editor-head { width: 100%; height: 12; flex-shrink: 0; flex-direction: row; gap-all: 2; }
.auto-editor-head .auto-file-tabs { flex: 1; min-width: 0; }
.domain-panel .kind-chip.auto-view-chip { width: 34; }
.auto-graph-box { width: 100%; flex: 1; min-height: 0; }
.auto-variables { width: 100%; height: 16; flex-shrink: 0; flex-direction: row; align-items: center; gap-all: 3; padding-left: 6; background: #ff1a1822; }
.domain-panel .auto-variables-title { adaptive-width: true; height: 9; flex-shrink: 0; margin-right: 3; text-color: #ffaaa4b2; }
.domain-panel .auto-variable { height: 12; flex-shrink: 0; padding-left: 4; padding-top: 2; text-wrap: hide; text-color: #ffefeaf8; }
.auto-graph { width: 100%; flex: 1; min-height: 0; allow-pan: true; allow-zoom: true; min-scale: 0.5; max-scale: 2; grid-size: 24; grid-subdivisions: 4; grid-min-pixels: 8; grid-line-color: #ff2c2935; grid-accent-color: #ff2c2935; background: #ff201e27; }
.auto-script { width: 100%; flex: 1; min-height: 0; }
.auto-problems { width: 100%; flex-shrink: 0; gap-all: 2; }
.auto-divider { width: 100%; height: 1; flex-shrink: 0; background: #ff3a3545; }
.domain-panel .problem-line { width: 16; height: 9; flex-shrink: 0; text-color: #ffff6a75; }
.domain-panel .script-editor { width: 100%; flex: 1; min-height: 0; font-size: 9; line-spacing: 3; text-color: #ffd6d0e0; cursor-color: #ffefeaf8; focus-overlay: empty; }
.domain-panel .script-editor .__text-area_content-view__ { padding-all: 0; padding-top: 3; background: #00000000; }
.domain-panel .script-editor .__text-area_horizontal-scroller__ { display: none; }

.domain-footer { width: 100%; height: 11; flex-shrink: 0; flex-direction: row; }
.domain-status { flex: 1; min-width: 0; height: 10; text-color: #ff6d6a82; }
// Processing feedback is shown on its page only, and only when there is something to report (FederationWorkspace).
.domain-panel .domain-footer .mapping-status { flex: 1; min-width: 0; height: 10; text-wrap: hide; }
.domain-panel .domain-status.accepted { text-color: #ff28633b; }
.domain-panel .domain-status.conflict { text-color: #ff79541b; }
.domain-panel .domain-status.stale_context, .domain-panel .domain-status.stale_revision, .domain-panel .domain-status.disabled { text-color: #ff922e42; }
.domain-panel .request-status { display: none; text-color: #ff79541b; }
.domain-panel .request-status.request-error { text-color: #ff922e42; }
.state-sync, .authority-sync { width: 0; height: 0; display: none; }

// The processing page keeps its current structure in the new palette.
.domain-heading { height: 10; flex-shrink: 0; }
.page-description { adaptive-height: true; flex-shrink: 0; text-wrap: wrap; }
.domain-panel .page-description { text-color: #ff6d6a82; }
.domain-panel selector { height: 18; flex-shrink: 0; background: built-in(federation:FIELD); }
.domain-panel .__selector_preview__ label { font-size: 9; }
.domain-panel .__selector_dialog__ { background: built-in(federation:FRAME); }
.choice-label { height: 12; padding-horizontal: 3; font-size: 9; text-color: #ff413f54; }
.domain-panel .__selector_preview__ .choice-label { height: 12; vertical-align: center; }
.processing-graph { flex: 1; min-height: 0; width: 100%; flex-direction: row; gap-all: 6; }
.processing-area { flex: 1; min-width: 0; height: 100%; }
.processing-scroll { width: 100%; height: 100%; background: #ff201e27; }
.processing-aside { width: 34%; min-width: 118; max-width: 340; height: 100%; flex-shrink: 0; gap-all: 4; }
.processing-detail { width: 100%; flex: 1; min-height: 0; scroller-view-mode: vertical; }
.processing-detail .__scroller_view_view-port__ { padding-all: 0; background: #00000000; }
.processing-detail .__scroller_view_view-container__ { width: 100%; gap-all: 3; }
.domain-panel .processing-title { width: 100%; adaptive-height: true; flex-shrink: 0; text-wrap: wrap; text-color: #ff413f54; }
.processing-ends { width: 100%; flex-shrink: 0; flex-direction: row; gap-all: 4; }
.processing-end { flex: 1; min-width: 0; gap-all: 2; }
.processing-thumb { width: 100%; height: 64; flex-shrink: 0; background: #ff0d0d11; padding-all: 1; }
.domain-panel .processing-end-label { width: 100%; adaptive-height: true; text-wrap: wrap; text-color: #ff6d6a82; }
.domain-panel .processing-help { width: 100%; adaptive-height: true; flex-shrink: 0; text-wrap: wrap; text-color: #ff6d6a82; }
.compact .processing-thumb { height: 30; }
.processing-facts { width: 100%; flex-shrink: 0; gap-all: 3; }
.processing-fact { width: 100%; flex-shrink: 0; flex-direction: row; gap-all: 4; align-items: flex-start; }
.domain-panel .processing-fact-name { width: 48; flex-shrink: 0; height: 9; text-color: #ffaaa4b2; }
.domain-panel .processing-fact-value { flex: 1; min-width: 0; adaptive-height: true; text-wrap: wrap; text-color: #ffd6d0e0; }
.processing-toggle { width: 100%; height: 18; flex-shrink: 0; }
// The actions sit right under the details, in a row; a narrow aside stacks them.
.processing-actions { width: 100%; flex-shrink: 0; flex-direction: row; gap-all: 3; }
.processing-actions button { flex: 1; height: 18; }
.domain-shell.compact .processing-actions { flex-direction: column; gap-all: 2; }
.domain-shell.compact .processing-actions button { flex-grow: 0; flex-shrink: 0; width: 100%; height: 16; }
// A narrow aside puts each fact's name above its value, so values keep a readable width.
.domain-shell.compact .processing-fact { flex-direction: column; gap-all: 0; }
.domain-shell.compact .domain-panel .processing-fact-name { width: 100%; }
.domain-shell.compact .domain-panel .processing-fact-value { flex-grow: 0; width: 100%; }
.domain-shell.compact .processing-toggle { height: 16; }
.compact .processing-aside { min-width: 104; }
.compact-actions { height: 18; flex-shrink: 0; flex-direction: row; gap-all: 3; }
.compact-actions button { flex: 1; }
.domain-panel .mapping-status { width: 100%; adaptive-height: true; flex-shrink: 0; text-wrap: wrap; text-color: #ff79541b; }
.domain-panel .mapping-status.feedback-neutral { text-color: #ff6d6a82; }
.domain-panel .mapping-status.feedback-waiting { text-color: #ff79541b; }
.domain-panel .mapping-status.feedback-success { text-color: #ff28633b; }
.domain-panel .mapping-status.feedback-error { text-color: #ff922e42; }
// The topology's Endpoint panel: one fact per row, its name on the left, as the processing facts.
.endpoint-fact { width: 100%; flex-shrink: 0; flex-direction: row; gap-all: 4; align-items: flex-start; }
.domain-panel .endpoint-fact-name { width: 80; flex-shrink: 0; adaptive-height: true; text-wrap: wrap; text-color: #ffaaa4b2; }
.domain-panel .endpoint-fact-value { flex: 1; min-width: 0; adaptive-height: true; text-wrap: wrap; text-color: #ffd6d0e0; }
.domain-shell.compact .endpoint-fact { flex-direction: column; gap-all: 0; }
.domain-shell.compact .domain-panel .endpoint-fact-name { width: 100%; }
.domain-shell.compact .domain-panel .endpoint-fact-value { flex-grow: 0; width: 100%; }
.endpoint-pattern { width: 100%; flex-shrink: 0; flex-direction: row; gap-all: 5; align-items: center; padding-all: 3; background: built-in(federation:DARK_PANEL); }
.endpoint-pattern-icon { width: 16; height: 16; flex-shrink: 0; }
.endpoint-pattern-lines { flex: 1; min-width: 0; gap-all: 1; }
.bridge-unavailable { display: none; flex: 1; min-height: 0; padding-all: 8; gap-all: 8; background: built-in(federation:DARK_PANEL); }
.domain-panel .bridge-unavailable label { text-color: #ffd6d0e0; }

// AE2's scrollbar: its 7-pixel scroller in the text field's inset.
.domain-panel .__scroller_view_vertical-scroller__ { width: 9; background: #00000000; }
.domain-panel .__scroller_scroll_container__ { padding-all: 1; background: built-in(federation:FIELD); }
.domain-panel button.__scroller_scroll_bar__ { base-background: built-in(federation:SCROLL_BAR); hover-background: built-in(federation:SCROLL_BAR); pressed-background: built-in(federation:SCROLL_BAR); }

// Narrow viewports keep controls reachable; the aside scrolls independently.
.domain-shell.compact .members-caption { display: none; }
.domain-shell.compact .graph-legend, .domain-panel .graph-legend.folded, .domain-shell.compact .graph-power { display: none; }
.domain-shell.compact #graph_search { width: 72; }
.domain-shell.compact .domain-tab { display: none; }
.domain-shell.compact .domain-panel .stat-row .stat-name { width: 44; }
.domain-shell.compact .domain-panel .stat-row .stat-value { min-width: 80; }

// The statistics page: networks across the top, the metrics on the left, the chosen one large on the right with the
// keys that moved most below it.
.stats-ranges { gap-all: 2; }
.domain-panel .header-tools .range-chip { width: 38; height: 16; padding-all: 0; padding-bottom: 2; base-background: built-in(federation:CHIP); hover-background: built-in(federation:CHIP_HOVER); pressed-background: built-in(federation:CHIP_HOVER); }
.domain-panel .header-tools .range-chip.selected { base-background: built-in(federation:CHIP_SELECTED); hover-background: built-in(federation:CHIP_SELECTED); }
.statistics-page { flex-direction: column; gap-all: 3; }
.stats-networks { width: 100%; height: 13; flex-shrink: 0; flex-direction: row; gap-all: 4; }
.domain-panel .network-chip { height: 13; flex-shrink: 0; padding-all: 0; padding-bottom: 1; base-background: built-in(federation:NETWORK_CHIP); hover-background: built-in(federation:NETWORK_CHIP_HOVER); pressed-background: built-in(federation:NETWORK_CHIP_HOVER); }
.domain-panel .network-chip.selected { base-background: built-in(federation:NETWORK_CHIP_SELECTED); hover-background: built-in(federation:NETWORK_CHIP_SELECTED); }
.domain-panel .network-chip.selected .__button_text__ { text-color: #ffefeaf8; }
.domain-panel .network-chip.dim .__button_text__ { text-color: #ffa4a6b4; }
.stats-body { flex: 1; min-height: 0; width: 100%; flex-direction: row; gap-all: 6; }
.stats-metrics { width: 26%; min-width: 112; max-width: 220; height: 100%; flex-shrink: 0; gap-all: 3; }
.stats-card { width: 100%; flex: 1; min-height: 18; }
.stats-main { flex: 1; min-width: 0; height: 100%; gap-all: 6; }
.stats-chart { width: 100%; flex: 1; min-height: 60; }
.stats-plot { width: 100%; height: 100%; }
.stats-kinds { position: absolute; left: 0; top: 3; width: 100%; height: 12; flex-direction: row; justify-content: center; gap-all: 2; }
.domain-panel .kind-chip { width: 44; height: 12; flex-shrink: 0; padding-all: 0; padding-bottom: 1; base-background: built-in(federation:KIND_CHIP); hover-background: built-in(federation:KIND_CHIP_HOVER); pressed-background: built-in(federation:KIND_CHIP_HOVER); }
.domain-panel .kind-chip .__button_text__ { text-color: #ffaaa4b2; }
.domain-panel .kind-chip.selected { base-background: built-in(federation:KIND_CHIP_SELECTED); hover-background: built-in(federation:KIND_CHIP_SELECTED); }
.domain-panel .kind-chip.selected .__button_text__ { text-color: #ffefeaf8; }
.domain-panel .kind-chip.colour-chip { width: 64; }
.stats-lower { width: 100%; height: 46%; min-height: 48; max-height: 200; flex-shrink: 0; }
.stats-layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.stats-filter { position: absolute; left: 5; top: 15; right: 5; height: 14; flex-direction: row; gap-all: 3; align-items: center; }
.domain-panel .stats-filter text-field { width: 45%; height: 14; padding-top: 3; background: #ff17141e; text-color: #ffefeaf8; }
.domain-shell.compact .stats-lower { display: none; }
.domain-shell.compact .stats-metrics { min-width: 96; }
